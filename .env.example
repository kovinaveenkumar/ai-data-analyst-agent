# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
# Model names change over time; check https://docs.claude.com and update if needed.
CLAUDE_MAIN_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# Optional: USD per million tokens, from https://www.anthropic.com/pricing (leave blank to show tokens only)
MAIN_INPUT_PRICE_PER_MTOK=
MAIN_OUTPUT_PRICE_PER_MTOK=
FAST_INPUT_PRICE_PER_MTOK=
FAST_OUTPUT_PRICE_PER_MTOK=

# --- Database: the READ-ONLY role created by db/init/03_readonly_role.sql ---
DATABASE_URL=postgresql://analyst_ro:analyst_ro_pw@localhost:5432/analytics
DB_SCHEMA=shop
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=30000

# --- MCP ---
# http = app talks to a separately running MCP server (python -m analyst.mcp_server.server)
# inprocess = MCP server runs inside the app process (simplest; used for tests and evaluation)
MCP_MODE=http
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# --- Agent behaviour ---
MAX_ATTEMPTS=3
USE_RESULT_VALIDATOR=true
MAX_QUESTIONS_PER_SESSION=25
